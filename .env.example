# Cluster Identification
NODE_NAME=node1

# Process 1 REST API Settings
API_HOST=0.0.0.0
API_PORT=8080

# Virtual IP / HAProxy Load Balancer Settings
FLOWFIRST_VIP=192.168.1.100

# RabbitMQ Connection Settings (Point to local broker, VIP, or cluster hosts)
RABBITMQ_HOST=192.168.1.100
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOSTS=192.168.1.101:5672,192.168.1.102:5672,192.168.1.103:5672

# MariaDB Connection Settings (Point to local node, VIP, or Galera Cluster)
MARIADB_HOST=192.168.1.100
MARIADB_PORT=3306
MARIADB_USER=flowuser
MARIADB_PASSWORD=flowpassword
MARIADB_DB=flowfirst_db
