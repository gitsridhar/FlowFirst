#---------------------------------------------------------------------
# Global settings
#---------------------------------------------------------------------
global
    log         127.0.0.1 local2 info
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats mode 660 level admin expose-fd listeners

#---------------------------------------------------------------------
# Common defaults
#---------------------------------------------------------------------
defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option                  http-server-close
    option forwardfor       except 127.0.0.0/8
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

#---------------------------------------------------------------------
# HAProxy Statistics Dashboard
#---------------------------------------------------------------------
listen stats
    bind 0.0.0.0:__HAPROXY_STATS_PORT__
    mode http
    stats enable
    stats uri /
    stats refresh 5s
    stats auth __HAPROXY_STATS_USER__:__HAPROXY_STATS_PASS__
    stats show-node

#---------------------------------------------------------------------
# Frontend: Process 1 REST API (Binds to Virtual IP / All Interfaces)
#---------------------------------------------------------------------
frontend flowfirst_api_front
    bind *:__API_PORT__
    mode http
    option httplog
    default_backend flowfirst_api_back

#---------------------------------------------------------------------
# Backend: Round-Robin Load Balancing across 3 Cluster Nodes
#---------------------------------------------------------------------
backend flowfirst_api_back
    mode http
    balance roundrobin
    option httpchk GET /health
    http-check expect status 200
    default-server inter 3s fall 2 rise 2

    # Cluster Node Physical IPs (populated from .env)
    server __NODE1_NAME__ __NODE1_IP__:__API_PORT__ check
    server __NODE2_NAME__ __NODE2_IP__:__API_PORT__ check
    server __NODE3_NAME__ __NODE3_IP__:__API_PORT__ check

#---------------------------------------------------------------------
# Load balancing & Failover for MariaDB Galera Cluster (Port 3306)
#---------------------------------------------------------------------
frontend mariadb_galera_front
    bind *:__MARIADB_PORT__
    mode tcp
    option tcplog
    default_backend mariadb_galera_back

backend mariadb_galera_back
    mode tcp
    balance roundrobin
    option tcp-check
    tcp-check connect port __MARIADB_PORT__
    default-server inter 3s fall 2 rise 2
    server __NODE1_NAME__ __NODE1_IP__:__MARIADB_PORT__ check
    server __NODE2_NAME__ __NODE2_IP__:__MARIADB_PORT__ check
    server __NODE3_NAME__ __NODE3_IP__:__MARIADB_PORT__ check

#---------------------------------------------------------------------
# Load balancing for RabbitMQ AMQP (Port 5672)
#---------------------------------------------------------------------
frontend rabbitmq_amqp_front
    bind *:__RABBITMQ_PORT__
    mode tcp
    option tcplog
    default_backend rabbitmq_amqp_back

backend rabbitmq_amqp_back
    mode tcp
    balance roundrobin
    timeout client-fin 50s
    timeout server-fin 50s
    server __NODE1_NAME__ __NODE1_IP__:__RABBITMQ_PORT__ check inter 5s fall 2 rise 2
    server __NODE2_NAME__ __NODE2_IP__:__RABBITMQ_PORT__ check inter 5s fall 2 rise 2
    server __NODE3_NAME__ __NODE3_IP__:__RABBITMQ_PORT__ check inter 5s fall 2 rise 2
