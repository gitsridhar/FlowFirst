#---------------------------------------------------------------------
# Global settings
#---------------------------------------------------------------------
global
    log         127.0.0.1 local2 info
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     __HAPROXY_MAXCONN__
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats mode 660 level admin expose-fd listeners user haproxy group haproxy
    # TLS policy for every 'ssl' bind/server below. Harmless when no bind/server uses ssl.
    ssl-default-bind-options     ssl-min-ver __TLS_MIN_VERSION__ no-tls-tickets
    ssl-default-bind-ciphers     __TLS_CIPHERS__
    ssl-default-bind-ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
    ssl-default-server-options   ssl-min-ver __TLS_MIN_VERSION__ no-tls-tickets
    ssl-default-server-ciphers   __TLS_CIPHERS__
    ssl-default-server-ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256

#---------------------------------------------------------------------
# Common defaults
#---------------------------------------------------------------------
defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option                  http-server-close
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 __HAPROXY_FRONTEND_MAXCONN__

#---------------------------------------------------------------------
# HAProxy Statistics Dashboard
#---------------------------------------------------------------------
listen stats
    bind 0.0.0.0:__HAPROXY_STATS_PORT__ __STATS_BIND_TLS__
    mode http
    stats enable
    stats uri /
    stats refresh 5s
    stats auth __HAPROXY_STATS_USER__:__HAPROXY_STATS_PASS__
    stats show-node

#---------------------------------------------------------------------
# Frontend: Process 1 REST API (Binds to Virtual IP / All Interfaces)
#---------------------------------------------------------------------
frontend flowfirst_api_front
    bind *:__API_PORT__ __API_BIND_TLS__
    mode http
    option httplog
    option forwardfor except 127.0.0.0/8
    # Buffer the request body so req.body_size is available for the size check below.
    # This does NOT buffer indefinitely: HAProxy enforces the client timeout while reading.
    option http-buffer-request
    # Reject oversized request bodies before they reach Process 1 (returns HTTP 413).
    # HAPROXY_MAX_BODY_BYTES must match or exceed API_MAX_BODY_BYTES in .env; the process
    # enforces the limit too, but stopping it at the load balancer saves a backend round-trip.
    # 0 means unlimited (disabled). Default: 1 MiB (same as API_MAX_BODY_BYTES default).
    http-request deny deny_status 413 if { req.body_size gt __HAPROXY_MAX_BODY_BYTES__ }
    # Never trust an identity header sent by a client; set it only from the verified client certificate.
    http-request del-header X-SSL-Client-CN
    http-request set-header X-SSL-Client-CN %[ssl_c_s_dn(cn)] if { ssl_c_used }
    __API_ACL__
    default_backend flowfirst_api_back

#---------------------------------------------------------------------
# Backend: Round-Robin Load Balancing across 3 Cluster Nodes
#---------------------------------------------------------------------
backend flowfirst_api_back
    mode http
    balance roundrobin
    # Disable server-side connection reuse so every request is independently round-robined.
    # Without this, HAProxy reuses an existing keep-alive connection to the same backend for
    # all requests on a single client connection — all requests land on the same node.
    http-reuse never
    option forwardfor except 127.0.0.0/8
    option httpchk GET /health
    http-check expect status 200
    default-server inter 3s fall 2 rise 2

    # Cluster Node Physical IPs pointing to Process 1 instances (port 8082)
    server __NODE1_NAME__ __NODE1_IP__:__API_BACKEND_PORT__ check __API_TLS_N1__
    server __NODE2_NAME__ __NODE2_IP__:__API_BACKEND_PORT__ check __API_TLS_N2__
    server __NODE3_NAME__ __NODE3_IP__:__API_BACKEND_PORT__ check __API_TLS_N3__

#---------------------------------------------------------------------
# Load balancing & Failover for MariaDB Galera Cluster (Port 3306)
#---------------------------------------------------------------------
# Bind to VIP only — MariaDB and RabbitMQ already own their ports on 0.0.0.0
# on every cluster node.  Binding to the VIP address avoids the "address already
# in use" conflict: the real services listen on the node IP, HAProxy listens on
# the VIP (which Pacemaker assigns to exactly one node at a time).
frontend mariadb_galera_front
    bind *:__MARIADB_LB_PORT__
    mode tcp
    option tcplog
    default_backend mariadb_galera_back

backend mariadb_galera_back
    mode tcp
    balance roundrobin
    option tcp-check
    tcp-check connect port __MARIADB_PORT__
    default-server inter 3s fall 2 rise 2
    server __NODE1_NAME__ __NODE1_IP__:__MARIADB_PORT__ check
    server __NODE2_NAME__ __NODE2_IP__:__MARIADB_PORT__ check
    server __NODE3_NAME__ __NODE3_IP__:__MARIADB_PORT__ check

#---------------------------------------------------------------------
# Load balancing for RabbitMQ AMQP (Port 5672 -> LB Port 5673)
#---------------------------------------------------------------------
# MariaDB and RabbitMQ are balanced in TCP mode: HAProxy does NOT terminate their TLS. The client
# negotiates TLS end to end with the chosen node, so those server certificates must be valid for the VIP
# name/address too (security/issue_all.sh does this).
frontend rabbitmq_amqp_front
    bind *:__RABBITMQ_LB_PORT__
    mode tcp
    option tcplog
    default_backend rabbitmq_amqp_back

backend rabbitmq_amqp_back
    mode tcp
    balance roundrobin
    timeout client-fin 50s
    timeout server-fin 50s
    server __NODE1_NAME__ __NODE1_IP__:__RABBITMQ_BACKEND_PORT__ check inter 5s fall 2 rise 2
    server __NODE2_NAME__ __NODE2_IP__:__RABBITMQ_BACKEND_PORT__ check inter 5s fall 2 rise 2
    server __NODE3_NAME__ __NODE3_IP__:__RABBITMQ_BACKEND_PORT__ check inter 5s fall 2 rise 2

#---------------------------------------------------------------------
# Load balancing for the Swift cluster (proxy port -> LB Port on the VIP)
#---------------------------------------------------------------------
# Every node runs a swift-proxy on __SWIFT_PROXY_PORT__ (swift/setup_swift.sh).
# /healthcheck is answered by the proxy only when it is up.  Large object PUTs
# can be slow, so the server timeout is raised for this backend.
frontend swift_front
    bind *:__SWIFT_LB_PORT__ __SWIFT_BIND_TLS__
    mode http
    option httplog
    default_backend swift_back

backend swift_back
    mode http
    balance roundrobin
    option httpchk GET /healthcheck
    http-check expect status 200
    timeout server 5m
    default-server inter 3s fall 2 rise 2
    server __NODE1_NAME__ __NODE1_IP__:__SWIFT_PROXY_PORT__ check __SWIFT_TLS_N1__
    server __NODE2_NAME__ __NODE2_IP__:__SWIFT_PROXY_PORT__ check __SWIFT_TLS_N2__
    server __NODE3_NAME__ __NODE3_IP__:__SWIFT_PROXY_PORT__ check __SWIFT_TLS_N3__
