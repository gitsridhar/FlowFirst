# ==============================================================================
# MariaDB Galera Cluster Configuration for FlowFirst (RHEL 9.6)
# Generated by mariadb-galera/setup_galera_node.sh from this template.
# ==============================================================================

[mysqld]
binlog_format=ROW
default_storage_engine=InnoDB
innodb_autoinc_lock_mode=2
bind-address=0.0.0.0

# Galera Provider Configuration
wsrep_on=ON
wsrep_provider=__MARIADB_GALERA_WSREP_PROVIDER__

# Galera Cluster Configuration
wsrep_cluster_name="__MARIADB_GALERA_CLUSTER_NAME__"
wsrep_cluster_address="gcomm://__GALERA_CLUSTER_ADDRESSES__"

# Galera Synchronization & Recovery
# wsrep_sst_method controls the full-copy transfer method used when IST cannot
# be used (i.e. the joiner is too far behind the donor's gcache window).
#   rsync        — simple, no extra packages, BUT blocks the donor and is unencrypted.
#   mariabackup  — non-blocking donor, encrypted when MARIADB_SST_ENCRYPT=true (see below),
#                  requires mariadb-backup package (sudo dnf install -y mariadb-backup).
# Controlled by MARIADB_SST_METHOD in .env (default: rsync).
wsrep_sst_method=__MARIADB_SST_METHOD__

# Galera Write-Set Cache (gcache)
# gcache.size controls how many bytes of recent write-sets Galera retains on
# disk for IST (Incremental State Transfer).
# - If the joiner's gap fits inside the donor's gcache window → IST is used
#   (fast: only missing write-sets are streamed, donor stays online).
# - If the gap exceeds gcache → SST is used
#   (slow: full data copy via wsrep_sst_method, donor is paused/desynced).
# Default: 128M  Recommended minimum for production: 512M–2G
# Set higher on write-heavy clusters to maximise IST reuse.
wsrep_provider_options="gcache.size=512M"

# Galera Node Configuration (Configured dynamically per node from environment)
wsrep_node_address="__CURRENT_NODE_IP__"
wsrep_node_name="__CURRENT_NODE_NAME__"

# SST encryption (mariabackup only; ignored for rsync).
# Written only when MARIADB_SST_METHOD=mariabackup AND MARIADB_SST_ENCRYPT=true.
# Uses the same CA and node certificates as the Galera TLS work (Scenario 63).
# Set the paths in .env: TLS_DIR, TLS_CA_FILE, TLS_CLIENT_CERT, TLS_CLIENT_KEY.
__SST_ENCRYPT_BLOCK__
