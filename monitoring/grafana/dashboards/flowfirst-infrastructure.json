{
  "uid": "flowfirst-infrastructure",
  "title": "FlowFirst - Infrastructure",
  "description": "MariaDB Galera, RabbitMQ and host metrics for the nodes that run FlowFirst. Needs the rabbitmq_prometheus plugin, mysqld_exporter (port 9114) and node_exporter (port 9100).",
  "tags": [
    "flowfirst",
    "infrastructure"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "flowfirst-prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "v_instance"
        },
        "definition": "label_values(node_uname_info, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health at a glance",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Galera cluster size",
      "description": "Smallest wsrep_cluster_size any node reports. Alert below 3 (GaleraClusterSizeLow).",
      "datasource": {
        "type": "prometheus",
        "uid": "flowfirst-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "flowfirst-prometheus"
          },
          "expr": "min(mysql_global_status_wsrep_cluster_size{job=\"mysqld\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Galera nodes not Synced",
      "description": "Nodes whose wsrep_local_state is not 4 (Synced).",
      "datasource": {
        "type": "prometheus",
        "uid": "flowfirst-prometheus"
