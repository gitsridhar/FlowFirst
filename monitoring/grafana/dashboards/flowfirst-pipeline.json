      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "flowfirst-prometheus"
          },
          "expr": "sum by (flow) (rate(flowfirst_messages_total{process=\"api_gateway\",event=\"published\",flow=~\"$flow\"}[$__rate_interval]))",
          "legendFormat": "flow {{flow}}"
