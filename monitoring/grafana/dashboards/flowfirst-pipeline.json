    {
      "id": 10,
      "type": "timeseries",
      "title": "Accepted by the API (published/s)",
      "description": "API Gateway (Process 1): messages published to RabbitMQ, per flow.",
      "datasource": {
        "type": "prometheus",
        "uid": "flowfirst-prometheus"
