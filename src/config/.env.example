# ==============================================================================
# FlowFirst Environment & Network Configuration
# Copy this file to .env on every node:
#   cp .env.example .env
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  ⚠  REPLACE ALL IP ADDRESSES BELOW WITH YOUR ACTUAL NETWORK VALUES  ⚠      │
# │                                                                             │
# │  The 192.168.1.x values shown here are EXAMPLES ONLY.                      │
# │  They are NOT hardcoded anywhere in the application scripts.                │
# │  Every script, config.py, and README command reads IPs from this file.      │
# │  Set your real node IPs and VIP before running anything.                    │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# ── PER-NODE VALUES (change these on each node) ───────────────────────────────
# Two variables must be set to the identity of the node this .env file lives on:
#
#   NODE_NAME       — the hostname of THIS node (must match /etc/hostname and
#                     the name used in `pcs cluster setup`).
#                     node1 → NODE_NAME=node1
#                     node2 → NODE_NAME=node2
#                     node3 → NODE_NAME=node3
#                     node4 → NODE_NAME=node4 (Remote Node running Process 5)
#
#   CURRENT_NODE_IP — the primary IP address of THIS node's cluster/network interface.
#                     node1 → CURRENT_NODE_IP=<node1-actual-ip>
#                     node2 → CURRENT_NODE_IP=<node2-actual-ip>
#                     node3 → CURRENT_NODE_IP=<node3-actual-ip>
#                     node4 → CURRENT_NODE_IP=<node4-actual-ip>
#
# Every other variable is identical on all nodes.
#
# ── SHARED VALUES (identical on all nodes) ────────────────────────────────────
# NODE1_IP / NODE2_IP / NODE3_IP / NODE4_IP list node IPs across the environment.
# config.py uses NODE1_IP..NODE3_IP to build the full RabbitMQ and MariaDB host lists.
#
# python-dotenv does NOT expand ${VAR} references.  Use literal values only.
# ==============================================================================

# ── Per-node identity (edit these two lines on each node) ────────────────────
# Replace 192.168.1.x with your actual node IPs:
# On node1: NODE_NAME=node1   CURRENT_NODE_IP=<node1-ip>
# On node2: NODE_NAME=node2   CURRENT_NODE_IP=<node2-ip>
# On node3: NODE_NAME=node3   CURRENT_NODE_IP=<node3-ip>
# On node4: NODE_NAME=node4   CURRENT_NODE_IP=<node4-ip> (Remote Node)
CLUSTER_NAME=flowfirst_cluster
NODE_NAME=node1
CURRENT_NODE_IP=192.168.1.101

# ── All node IPs (same on every node) ────────────────────────────────────────
# List all nodes regardless of which node this file is on.
NODE1_NAME=node1
NODE1_IP=192.168.1.101

NODE2_NAME=node2
NODE2_IP=192.168.1.102

NODE3_NAME=node3
NODE3_IP=192.168.1.103

NODE4_NAME=node4
NODE4_IP=192.168.1.104

# Virtual IP (VIP) & Network Interface Settings
FLOWFIRST_VIP=192.168.1.100
# VIP_NIC must be the physical cluster NIC name on THIS node.
# It may differ across nodes if hardware varies (RHEL 9 uses predictable names).
# To auto-detect:  ip route get 192.168.1.100 | awk '{print $5; exit}'
# To list all:     ip -o link show | awk -F': ' '{print $2}'
# Common names:    ens3, ens192, enp0s3, eth0, bond0
VIP_NIC=ens3
VIP_CIDR_NETMASK=24

# Time Synchronisation (chrony)
# NTP server used by scripts/setup_chronyd.sh.
# Leave blank to use the default public pool (pool.ntp.org).
# For air-gapped environments set this to your local NTP server IP.
# Example: CHRONY_NTP_SERVER=192.168.1.1
CHRONY_NTP_SERVER=

# ZooKeeper Ensemble Settings
# ZK_HOSTS is built automatically from NODE1_IP..NODE3_IP by config.py if left blank.
# Override here only if your ZK ensemble uses non-standard IPs or ports.
# Example: ZK_HOSTS=192.168.1.101:2181,192.168.1.102:2181,192.168.1.103:2181
ZK_HOSTS=
ZK_CLIENT_PORT=2181
ZK_PEER_PORT=2888
ZK_ELECTION_PORT=3888
ZK_ADMIN_PORT=8081
ZK_TIMEOUT=10
# Dedup barrier TTL in milliseconds (how long to remember a processed message_id)
ZK_DEDUP_TTL_MS=300000
# ZooKeeper JVM heap (MB) — used by zookeeper/setup_zookeeper.sh
ZK_HEAP_MB=256
# ZooKeeper version to download — used by zookeeper/setup_zookeeper.sh
ZK_VERSION=3.9.2

# Greenthread (eventlet) Settings
# GT_POOL_SIZE: max concurrent greenthreads per process (default 1000)
GT_POOL_SIZE=1000
# GT_WORKER_CONCURRENCY: concurrent HTTP request handlers in Process 1 (default 4)
GT_WORKER_CONCURRENCY=4
# LOG_LEVEL: level for all FlowFirst loggers (DEBUG, INFO, WARNING, ERROR). Default INFO.
# gt.configure_logging() sends them to stdout (the journal) AND to a rotating file per process.
# DEBUG adds ZK dedup per-message lines and the Process 4 history step lines.
LOG_LEVEL=INFO
# LOG_DIR: directory for <process>.log files (process1.log ... process5.log). Default /var/log/flowfirst.
# Created by systemd (LogsDirectory=flowfirst). Leave blank to disable file logging (journal only).
LOG_DIR=/var/log/flowfirst
# LOG_MAX_BYTES: rotate a log file when it reaches this size (default 52428800 = 50 MiB)
LOG_MAX_BYTES=52428800
# LOG_BACKUP_COUNT: rotated files kept per process (default 7), so at most 8 x 50 MiB per process
LOG_BACKUP_COUNT=7
# GT_METRICS_INTERVAL_S: how often each process logs throughput stats (seconds)
GT_METRICS_INTERVAL_S=60
# GT_DEDUP_REAP_INTERVAL_S: how often Process 4 cleans expired ZK dedup znodes
GT_DEDUP_REAP_INTERVAL_S=600

# Process 1 REST API Settings
# Process 1 listens on API_BACKEND_PORT (8082). HAProxy frontend listens on API_PORT (8080).
API_HOST=0.0.0.0
API_PORT=8080
API_BACKEND_PORT=8082

# ---------------------------------------------------------------------------
# Scale parameters — see Scenario 61 in ReadMe.md. The defaults below reproduce the
# original fixed behaviour, so leaving them alone changes nothing. Change them on
# EVERY node (they are identical across nodes), then restart the processes /
# re-run haproxy/setup_haproxy.sh.
# ---------------------------------------------------------------------------
# API_REQUEST_POOL_SIZE: HTTP requests ONE Process 1 serves at the same time.
#   0 = GT_WORKER_CONCURRENCY x 10 (= 40). Requests beyond this wait in the socket backlog.
API_REQUEST_POOL_SIZE=0
# API_LISTEN_BACKLOG: connections the kernel queues for Process 1 while all workers are busy
#   (default 50). The kernel silently caps it at net.core.somaxconn (4096 on RHEL 9).
API_LISTEN_BACKLOG=50
# GT_CONSUMERS_PER_QUEUE: consumer greenthreads per queue in Processes 2-5. Each opens its own
#   RabbitMQ connection (and, in Process 4, its own MariaDB connection while inserting).
GT_CONSUMERS_PER_QUEUE=1
# GT_PREFETCH_COUNT: unacknowledged messages RabbitMQ gives one consumer at a time.
GT_PREFETCH_COUNT=1
# HAPROXY_MAXCONN / HAPROXY_FRONTEND_MAXCONN: HAProxy 'global maxconn' and per-frontend
#   'defaults maxconn' (read by haproxy/setup_haproxy.sh). Must exceed peak concurrent clients.
HAPROXY_MAXCONN=4000
HAPROXY_FRONTEND_MAXCONN=3000
# HAPROXY_MAX_BODY_BYTES: request body limit on the API frontend (HTTP 413 for larger requests).
#   Set to 0 to disable. Must be >= API_MAX_BODY_BYTES (the process also enforces it independently).
#   Default: 1 MiB (1048576) = same as API_MAX_BODY_BYTES.
HAPROXY_MAX_BODY_BYTES=1048576
# Related, already defined above/below: GT_POOL_SIZE, GT_WORKER_CONCURRENCY, ZK_DEDUP_TTL_MS,
#   GT_DEDUP_REAP_INTERVAL_S (dedup znodes pile up at high rates), SWIFT_ENABLED (set false to
#   measure the MariaDB-only ceiling), LOG_LEVEL (WARNING removes per-request log lines).

# Load generator parameters (scripts/load_test_api.py, run from a client host — not read by the services)
# LOAD_TARGET_URL: where to send requests. Blank = http://<FLOWFIRST_VIP>:<API_PORT>
LOAD_TARGET_URL=
# LOAD_STEPS: concurrent in-flight requests per step; the test climbs the list and stops at the first
#   step that breaks the limits below. Use a single number for a one-off run.
LOAD_STEPS=50,100,250,500,1000,2000,4000
# LOAD_STEP_DURATION_S: seconds each step runs at full concurrency (after the ramp)
LOAD_STEP_DURATION_S=30
# LOAD_RAMP_S: seconds over which each step adds its virtual users (avoids a thundering herd)
LOAD_RAMP_S=5
# LOAD_FLOW_MIX: request mix as name:weight pairs. Names: flow1, flow2, flow3, health
LOAD_FLOW_MIX=flow1:45,flow2:45,flow3:10
# LOAD_TIMEOUT_S: a request not fully answered within this time counts as an error
LOAD_TIMEOUT_S=30
# LOAD_KEEPALIVE: true = each virtual user reuses one TCP connection (typical for client pools);
#   false = a new connection per request (stress test; needs a wide client port range, see Scenario 61)
LOAD_KEEPALIVE=true
# LOAD_SLO_P95_MS / LOAD_MAX_ERROR_PCT: a step passes only if p95 latency and error rate stay within these
LOAD_SLO_P95_MS=1000
LOAD_MAX_ERROR_PCT=1.0
# LOAD_THINK_MS: average pause (ms, +/-50% jitter) each virtual user takes after a response. 0 = no pause
#   (each VU re-sends at once, the hardest test). Use it to model real users:
#   requests/s = VUs / ((latency + think time) in seconds).
LOAD_THINK_MS=0
# LOAD_ITEM_ID_BASE: first item_id used; every request gets the next number, so rows are easy to find
LOAD_ITEM_ID_BASE=9000000
# LOAD_DRAIN_TIMEOUT_S: after the last step, wait this long for the RabbitMQ queues to empty (0 = skip)
LOAD_DRAIN_TIMEOUT_S=300
# LOAD_REPORT_INTERVAL_S: also print one result line every N seconds inside each step (and save them to
#   <csv>.windows.csv). Used for soak tests to see latency / backlog trends. 0 = only the end-of-step line
LOAD_REPORT_INTERVAL_S=0

# RABBITMQ_MGMT_PORT: management API port, used by the load generator to read queue depth
RABBITMQ_MGMT_PORT=15672

# ==============================================================================
# TLS / certificates (see security/ and ReadMe Scenario 63)
# ==============================================================================
# Create the CA and certificates once on an admin host:  ./security/init_ca.sh  &&  ./security/issue_all.sh
# then copy them to the nodes:                            ./security/install_certs.sh
# Every switch below is OFF by default. Turn a component on only after its server side is configured
# (security/enable_*.sh). When a switch is on and a certificate file is missing, the process refuses to
# start - it never falls back to plaintext. Literal values only (no ${VAR}).
TLS_DIR=/etc/flowfirst/tls
# TLS_CA_FILE / TLS_CLIENT_CERT / TLS_CLIENT_KEY / TLS_API_CERT / TLS_API_KEY default to files under TLS_DIR;
# leave them blank unless you keep the files elsewhere.
TLS_CA_FILE=
TLS_CLIENT_CERT=
TLS_CLIENT_KEY=
# TLS_CRL_FILE: set to /etc/flowfirst/tls/ca.crl to reject revoked certificates. Blank = no check.
TLS_CRL_FILE=
# TLS_MIN_VERSION: 1.2 or 1.3.  TLS_CIPHERS: TLS 1.2 suites (OpenSSL syntax); blank = library default.
TLS_MIN_VERSION=1.2
TLS_CIPHERS=ECDHE+AESGCM:ECDHE+CHACHA20
# Process 1 serves HTTPS on API_BACKEND_PORT. TLS_API_CLIENT_AUTH: required (mutual TLS) | optional | none
TLS_API_ENABLED=false
TLS_API_CERT=
TLS_API_KEY=
TLS_API_CLIENT_AUTH=required
# Connections made by the pipeline processes
TLS_RABBITMQ_ENABLED=false
RABBITMQ_TLS_PORT=5671
TLS_MARIADB_ENABLED=false
TLS_ZK_ENABLED=false
ZK_TLS_CLIENT_PORT=2281
# Swift: when true SWIFT_AUTH_URL below must start with https:// (the process refuses http:// then)
TLS_SWIFT_ENABLED=false

# HAProxy Settings
# HAPROXY_VIP_PEM / HAPROXY_BACKEND_PEM: leave blank to use TLS_DIR/haproxy/vip.pem and backend.pem
HAPROXY_VIP_PEM=
HAPROXY_BACKEND_PEM=
HAPROXY_STATS_PORT=9000
HAPROXY_STATS_USER=admin
# SECRETS: leave these blank/placeholder and run ./scripts/generate_secrets.sh --write (see the SECRETS block below)
HAPROXY_STATS_PASS=changeme-run-generate-secrets

# RabbitMQ Credentials & Ports
# NOTE: python-dotenv does NOT expand ${VAR} references — use literal values only.
# config.py builds RABBITMQ_HOSTS dynamically from NODE1_IP..NODE3_IP at runtime,
# so you only need to set the port and credentials here.
RABBITMQ_HOST=192.168.1.100
RABBITMQ_PORT=5672
RABBITMQ_LB_PORT=5673
RABBITMQ_USER=flowuser
RABBITMQ_PASSWORD=changeme-run-generate-secrets
# Leave RABBITMQ_HOSTS blank — config.py builds it from NODE*_IP + RABBITMQ_PORT
RABBITMQ_HOSTS=

# Queue replication type. "classic" (default) keeps each queue on one RabbitMQ node — a node that dies before the message
# is consumed can lose the messages stored on it. "quorum" replicates every queue via Raft across all nodes and a publisher
# confirm is sent only after a majority has the message. Changing this after the queues already exist requires the pipeline
# to be stopped and scripts/migrate_queue_type.py to be run. MUST be set to the same value on all nodes.
RABBITMQ_QUEUE_TYPE=classic

# MariaDB / Galera Credentials & Ports
# NOTE: python-dotenv does NOT expand ${VAR} references — use literal values only.
# config.py builds MARIADB_HOSTS dynamically from NODE1_IP..NODE3_IP at runtime.
MARIADB_HOST=192.168.1.100
MARIADB_PORT=3306
MARIADB_LB_PORT=3307
MARIADB_USER=flowuser
MARIADB_PASSWORD=changeme-run-generate-secrets
MARIADB_DB=flowfirst_db
# Leave MARIADB_HOSTS blank — config.py builds it from NODE*_IP at runtime
MARIADB_HOSTS=
MARIADB_GALERA_CLUSTER_NAME=flowfirst_galera_cluster
MARIADB_GALERA_WSREP_PROVIDER=/usr/lib64/galera-4/libgalera_smm.so

# Galera SST (State Snapshot Transfer) method.
#   rsync        — default: no extra packages, but blocks the donor during the copy and is UNENCRYPTED.
#                  Acceptable when the cluster network is private and not shared with untrusted traffic.
#   mariabackup  — recommended: non-blocking donor. Requires 'mariadb-backup' package (setup_galera_node.sh
#                  installs it automatically when this is set). Set MARIADB_SST_ENCRYPT=true to encrypt the
#                  transfer using the same TLS certificates as the Galera TLS work (Scenario 63):
#                  TLS_DIR / TLS_CA_FILE / TLS_CLIENT_CERT / TLS_CLIENT_KEY must point at the issued certs.
#                  All nodes must use the same method and, if encrypting, the same certs (run setup_galera_node.sh
#                  on all nodes, then rolling-restart: node3 → node2 → node1).
MARIADB_SST_METHOD=rsync
MARIADB_SST_ENCRYPT=false

# Swift Object Storage — native 3-node cluster installed by swift/setup_swift.sh
# Clients (Process 1 and 4, all nodes incl. node4) reach it through HAProxy on the VIP.
SWIFT_ENABLED=true
SWIFT_AUTH_URL=http://192.168.1.100:8090/auth/v1.0
SWIFT_AUTH_VERSION=1.0
# tempauth credentials, format '<account>:<user>' — created by swift/setup_swift.sh
SWIFT_USER=test:tester
SWIFT_KEY=changeme-run-generate-secrets
SWIFT_CONTAINER=flowfirst_messages

# Swift server settings — used by swift/setup_swift.sh and haproxy/setup_haproxy.sh
# SWIFT_LB_PORT is the HAProxy port on the VIP; SWIFT_PROXY_PORT is the swift-proxy
# port on each of node1-3 (8080 is taken by the FlowFirst API frontend).
SWIFT_LB_PORT=8090
SWIFT_PROXY_PORT=8888
SWIFT_ACCOUNT_PORT=6202
SWIFT_CONTAINER_PORT=6201
SWIFT_OBJECT_PORT=6200
# CentOS Cloud SIG OpenStack release that provides the Swift RPMs on RHEL 9
SWIFT_OPENSTACK_RELEASE=epoxy
# Data directory is SWIFT_DEVICES_DIR/SWIFT_DEVICE. For production mount a dedicated
# XFS filesystem there and set SWIFT_MOUNT_CHECK=true.
SWIFT_DEVICES_DIR=/srv/node
SWIFT_DEVICE=flowfirst
SWIFT_MOUNT_CHECK=false
SWIFT_REPLICAS=3
SWIFT_PART_POWER=10
SWIFT_RING_SEED=12345
MEMCACHED_PORT=11211
# Cluster-wide secrets: MUST be identical on node1-3 and NEVER changed after data is
# stored. Generate once with: openssl rand -hex 16
SWIFT_HASH_PATH_PREFIX=changeme-run-openssl-rand-hex-16
SWIFT_HASH_PATH_SUFFIX=changeme-run-openssl-rand-hex-16

# ---------------------------------------------------------------------------
# SECRETS (fail closed)
# Processes and install scripts REFUSE to start when RABBITMQ_PASSWORD, MARIADB_PASSWORD, SWIFT_KEY (if SWIFT_ENABLED)
# or HAPROXY_STATS_PASS is empty, shorter than SECRET_MIN_LENGTH, or a well-known sample value (flowpassword, admin123,
# testing, changeme*, ...). Generate strong values once, BEFORE the first install:
#     ./scripts/generate_secrets.sh --write        # also sets the two SWIFT_HASH_PATH_* values
# and copy the same .env to every node (only NODE_NAME / CURRENT_NODE_IP differ).
# ALLOW_DEFAULT_SECRETS=true is for a throw-away local/Docker dev setup ONLY: it turns the refusal into a warning.
# ---------------------------------------------------------------------------
SECRET_MIN_LENGTH=12
ALLOW_DEFAULT_SECRETS=false

# ---------------------------------------------------------------------------
# ADMIN AUTHORISATION (POST /zk/config changes runtime behaviour of the whole cluster)
# Reading config (GET) stays open to any API client; WRITING it needs an allow-listed certificate identity.
# ADMIN_ALLOWED_CNS: comma-separated certificate Common Names that may write, e.g. admin-client,alice
#   Blank = nobody can (fail closed). Needs TLS_API_ENABLED=true so the caller has a certificate.
# ADMIN_TRUSTED_PROXY_CNS: the CN of the HAProxy backend certificate on each node (<node>-pipeline), so Process 1 may
#   accept the caller identity HAProxy forwards in X-SSL-Client-CN. Use the node1..node3 pipeline names:
#   a header from any other certificate is ignored.
# ALLOW_UNAUTHENTICATED_ADMIN=true: dev-only, for a setup WITHOUT TLS (nobody can be identified). Never on a real node.
# ---------------------------------------------------------------------------
ADMIN_ALLOWED_CNS=admin-client
ADMIN_TRUSTED_PROXY_CNS=node1-pipeline,node2-pipeline,node3-pipeline
ALLOW_UNAUTHENTICATED_ADMIN=false

# ---------------------------------------------------------------------------
# FLOW-ENDPOINT AUTHENTICATION (Process 1). Protects /api/flow1-3, /api/batch, /api/batch.
#
# AUTH_MODE:
#   none     (default) — no authentication required. Admin endpoint is still cert-gated above.
#   api_key  — every flow request must include X-Api-Key: <raw_key>
#   token    — Authorization: Bearer <token> (issued by POST /auth/token) OR X-Api-Key accepted
#   cert     — any valid client certificate signed by the FlowFirst CA; requires TLS_API_ENABLED=true
#
# AUTH_API_KEYS: comma-separated 'label:sha256_hex' pairs. Store digests, never raw keys.
#   Generate:  python3 -c "import secrets,hashlib; k=secrets.token_urlsafe(32);
#     print(f'myapp:{hashlib.sha256(k.encode()).hexdigest()}  # raw key: {k}')"
#
# AUTH_TOKEN_SECRET: random hex secret for HMAC-SHA256 token signing (minimum 32 chars).
#   Generate:  python3 -c "import secrets; print(secrets.token_hex(32))"
#   Must be identical on all nodes. Rotate: change this value and restart all Process 1 instances.
#   Any token signed with the old secret is immediately invalid.
#
# AUTH_TOKEN_TTL_S: bearer token lifetime in seconds (default 3600 = 1 h).
# ---------------------------------------------------------------------------
AUTH_MODE=none
AUTH_API_KEYS=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_S=3600

# ---------------------------------------------------------------------------
# PER-ENDPOINT AUTHORIZATION (Process 1). Runs AFTER authentication.
# Authentication answers "who are you?"; authorization answers "what are you
# allowed to do?".  Off by default (AUTHZ_MODE=none) — existing behaviour.
#
# AUTHZ_MODE: none | rbac | acl | abac | rbac+acl | rbac+abac | rbac+acl+abac
#   none         No per-endpoint authorization (default, original behaviour).
#   rbac         Built-in roles: publisher, reader, admin, operator. Custom
#                roles via AUTHZ_ROLES.  Identities mapped via AUTHZ_IDENTITY_ROLES.
#   acl          Explicit per-resource allow-lists via AUTHZ_ACL.
#   abac         Attribute-based JSON policy rules via AUTHZ_POLICY.
#   rbac+acl     RBAC is checked first; ACL can grant what RBAC denied.
#   rbac+abac    RBAC first; ABAC allow rules can grant what RBAC denied; ABAC
#                deny rules always fire first regardless of mode.
#   rbac+acl+abac  All three layers (recommended for production).
#
# Built-in roles (always available without AUTHZ_ROLES):
#   publisher   may POST to /api/flow1-3 and /api/batch
#   reader      may GET /health, /ready, /gt/status, /zk/health, /zk/config,
#               /swift/objects, /swift/object/<name>
#   admin       reader + may POST /zk/config
#   operator    all of the above
#
# AUTHZ_ROLES: define additional custom roles.
#   Format: rolename=resource:action,resource:action;  rolename2=...
#   Example: AUTHZ_ROLES=ingest=flow:1:publish,flow:2:publish;  monitor=health:read,ready:read
#
# AUTHZ_IDENTITY_ROLES: map authenticated identities to roles.
#   Identity is the API key label, bearer token subject, or client certificate CN.
#   Format: identity1=role1,role2;  identity2=role3
#   Example: AUTHZ_IDENTITY_ROLES=ci_bot=publisher;  ops_team=operator;  alice=reader,publisher
#
# AUTHZ_ACL: per-resource explicit grants (exceptions/additions to RBAC).
#   Format: resource:action=identity1,identity2;  resource2:action=identity3
#   Example: AUTHZ_ACL=flow:1:publish=ci_bot,data_ingest;  zk:config:write=admin-cert
#
# AUTHZ_POLICY: JSON list of attribute-based rules (evaluated in order).
#   Supported "when" keys: identity, role, action, resource, method,
#     hour_utc_lt (UTC hour < N), hour_utc_gte (UTC hour >= N)
#   Example (deny publishes outside business hours, except for ci_bot):
#   AUTHZ_POLICY=[{"when":{"action":"publish","hour_utc_lt":8},"effect":"deny"},
#                 {"when":{"action":"publish","hour_utc_gte":18},"effect":"deny"},
#                 {"when":{"identity":"ci_bot"},"effect":"allow"}]
#
# Evaluation order when multiple components are active:
#   1. ABAC deny rules (explicit deny beats everything)
#   2. RBAC (role-based grants)
#   3. ACL (explicit per-resource grants; can override RBAC denial)
#   4. ABAC allow rules (last-chance grant)
#   5. Default: DENY (fail closed)
# ---------------------------------------------------------------------------
AUTHZ_MODE=none
AUTHZ_ROLES=
AUTHZ_IDENTITY_ROLES=
AUTHZ_ACL=
AUTHZ_POLICY=

# ---------------------------------------------------------------------------
# API REQUEST LIMITS (Process 1). Over a limit = refused with a clear 4xx, never silently truncated.
# API_MAX_BODY_BYTES    largest POST body                      (413 above it)           default 1048576
# API_MAX_BATCH_COUNT   largest "count" for POST /api/batch    (400 above it)           default 100
# API_MAX_LIST_LIMIT    largest "limit" for GET /swift/objects (400 above it)           default 1000
# API_REQUEST_TIMEOUT_S socket timeout per connection, so a stalled client frees its request slot   default 30
# API_EXPOSE_ERROR_DETAILS=true adds exception text to error responses. Development only: leave false
# where real users connect. Errors always carry a request_id that matches a line in the process log.
# ---------------------------------------------------------------------------
API_MAX_BODY_BYTES=1048576
API_MAX_BATCH_COUNT=100
API_MAX_LIST_LIMIT=1000
API_REQUEST_TIMEOUT_S=30
API_EXPOSE_ERROR_DETAILS=false

# ---------------------------------------------------------------------------
# PUBLISH CONNECTIONS (Process 1). Every publish waits for the broker's confirm, so a message is never
# reported as accepted unless RabbitMQ has it. One confirmed connection is slow, because each publish
# waits one round trip. Process 1 therefore keeps API_PUBLISH_CONNECTIONS connections and spreads
# requests over them. Illustrative figures from ONE RabbitMQ container on a 2-vCPU VM, 100 concurrent
# callers, a single run each, NOT a cluster: 1 connection ~1.3k msg/s, 4 ~2.6k, 8 ~4.3k (no confirms ~13k).
# Each connection costs one RabbitMQ connection per Process 1 instance. Range 1..32.   default 4
# ---------------------------------------------------------------------------
API_PUBLISH_CONNECTIONS=4

# ---------------------------------------------------------------------------
# MONITORING. When METRICS_ENABLED=true every process serves GET /metrics (Prometheus text format)
# on METRICS_PORT_BASE + its number: process1 9101 ... process5 9105. This is NOT behind HAProxy:
# Prometheus scrapes each node directly (Node 4 included). With TLS_API_ENABLED=true the listener
# uses the API certificate and TLS_API_CLIENT_AUTH, so Prometheus needs a client certificate.
# Open the ports to the Prometheus server only (see monitoring/ in the repo).   default false
# ---------------------------------------------------------------------------
METRICS_ENABLED=false
METRICS_HOST=0.0.0.0
METRICS_PORT_BASE=9100

