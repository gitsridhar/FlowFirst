[Unit]
Description=FlowFirst Process 1 - REST API Producer
After=network.target rabbitmq-server.service mariadb.service zookeeper.service
Wants=rabbitmq-server.service zookeeper.service

[Service]
Type=simple
User=flowuser
Group=flowuser
WorkingDirectory=/opt/flowfirst
EnvironmentFile=-/opt/flowfirst/.env
ExecStart=/opt/flowfirst/.venv/bin/python /opt/flowfirst/process1.py
Restart=always
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flowfirst-p1

# Timeout settings for clean shutdown under systemd
TimeoutStopSec=5s
KillMode=mixed
KillSignal=SIGTERM

# Security Sandbox options
# Greenthread support: allow up to 65536 open file descriptors per process
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
