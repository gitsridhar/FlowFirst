[Unit]
Description=FlowFirst Process 2 - Examiner & Reflector
After=network.target rabbitmq-server.service mariadb.service zookeeper.service
Wants=rabbitmq-server.service zookeeper.service

[Service]
Type=simple
User=flowuser
Group=flowuser
WorkingDirectory=/opt/flowfirst
EnvironmentFile=-/opt/flowfirst/.env
ExecStart=/opt/flowfirst/.venv/bin/python /opt/flowfirst/process2.py
Restart=always
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flowfirst-p2

# Security Sandbox options
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
