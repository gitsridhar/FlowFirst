[Unit]
Description=FlowFirst Transformer (Process 2) - Examiner & Reflector
After=network.target rabbitmq-server.service mariadb.service zookeeper.service
Wants=rabbitmq-server.service zookeeper.service

[Service]
Type=simple
User=flowuser
Group=flowuser
WorkingDirectory=/opt/flowfirst
EnvironmentFile=-/opt/flowfirst/.env
Environment=PYTHONUNBUFFERED=1
LogsDirectory=flowfirst
ExecStart=/opt/flowfirst/.venv/bin/python -m src.application.process2
Restart=always
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flowfirst-p2

# Allow enough time for the ZooKeeper session to close cleanly on shutdown.
# If the process is killed before the ZK session expires, stale election znodes
# are left behind and the next startup hangs waiting to win the election.
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

# Sandbox (file system, privileges, network, system calls): systemd/flowfirst-hardening.conf, installed as a drop-in.
# Greenthread support: allow up to 65536 open file descriptors per process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
