[Unit]
Description=FlowFirst Process 3 - Reflector & Forwarder
After=network.target rabbitmq-server.service mariadb.service zookeeper.service
Wants=rabbitmq-server.service zookeeper.service

[Service]
Type=simple
User=flowuser
Group=flowuser
WorkingDirectory=/opt/flowfirst
EnvironmentFile=-/opt/flowfirst/.env
ExecStart=/opt/flowfirst/.venv/bin/python /opt/flowfirst/process3.py
Restart=always
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flowfirst-p3

# Timeout settings for clean shutdown under systemd
TimeoutStopSec=5s
KillMode=mixed
KillSignal=SIGTERM

# Security Sandbox options
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
