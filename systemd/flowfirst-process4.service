[Unit]
Description=FlowFirst Process 4 - MariaDB Persister & Sink
After=network.target rabbitmq-server.service mariadb.service zookeeper.service
Wants=rabbitmq-server.service mariadb.service zookeeper.service

[Service]
Type=simple
User=flowuser
Group=flowuser
WorkingDirectory=/opt/flowfirst
EnvironmentFile=-/opt/flowfirst/.env
Environment=PYTHONUNBUFFERED=1
LogsDirectory=flowfirst
ExecStart=/opt/flowfirst/.venv/bin/python -m src.application.process4
Restart=always
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flowfirst-p4

# Timeout settings for clean shutdown under systemd
TimeoutStopSec=5s
KillMode=mixed
KillSignal=SIGTERM

# Sandbox (file system, privileges, network, system calls): systemd/flowfirst-hardening.conf, installed as a drop-in.
# Greenthread support: allow up to 65536 open file descriptors per process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
